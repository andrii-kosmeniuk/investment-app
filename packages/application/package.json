{
  "name": "@corgi/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./ports": { "types": "./src/ports.ts", "default": "./dist/ports.js" },
    "./testing": {
      "types": "./src/testing/in-memory-valuation.ts",
      "default": "./dist/testing/in-memory-valuation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corgi/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
