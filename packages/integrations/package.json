{
  "name": "@corgi/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./alpaca": { "types": "./src/alpaca/index.ts", "default": "./dist/alpaca/index.js" },
    "./plaid": { "types": "./src/plaid/index.ts", "default": "./dist/plaid/index.js" },
    "./persona": { "types": "./src/persona/index.ts", "default": "./dist/persona/index.js" },
    "./market-data": { "types": "./src/market-data/index.ts", "default": "./dist/market-data/index.js" },
    "./custodian-simulator": { "types": "./src/custodian-simulator/index.ts", "default": "./dist/custodian-simulator/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corgi/application": "workspace:*",
    "jose": "^6.0.10",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
