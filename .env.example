# Runtime
NODE_ENV=development
ENVIRONMENT_NAME=sandbox
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
HOST=0.0.0.0
PORT=4000

# Customer sessions (API signs, web stores in an httpOnly cookie)
SESSION_SECRET=replace-with-at-least-32-random-characters-kept-out-of-git
SESSION_TTL_HOURS=12
ORDER_CONFIRMATION_THRESHOLD_CENTS=100000
MAXIMUM_DEPOSIT_CENTS=5000000

# Seed (scripts/seed.ts) — demo password for olivia@demo.corgi and noah@demo.corgi
SEED_DEMO_PASSWORD=corgi-demo-2026

# Neon Postgres (sandbox/test database only)
# Pooled host (`-pooler`) for HTTP reads. Direct host for migrations and
# interactive ledger writes (advisory lock + deferred balance check).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Alpaca Broker sandbox and IEX market data
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_MARKET_DATA_BASE_URL=https://data.sandbox.alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=
# Optional but recommended in sandbox. When set, every customer trades on this one
# Broker-dashboard account instead of a per-customer POST /v1/accounts. It must be
# the *funded* account (Broker dashboard → Accounts → the one with buying power);
# accounts opened through the API have $0 because the JNLC funding bridge is on the
# cut list. Use the account id (uuid), not the account number.
ALPACA_SANDBOX_ACCOUNT_ID=

# Plaid sandbox
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# Worker: how often /transfer/event/sync is polled (ms).
PLAID_SYNC_MS=15000
# Worker, sandbox only (ADR-0008): Plaid sandbox transfers never leave `pending` by
# themselves; a deposit older than this is posted + settled through
# /sandbox/transfer/simulate. Ignored unless PLAID_BASE_URL contains "sandbox".
PLAID_SANDBOX_SETTLE_MS=60000

# Persona sandbox
PERSONA_BASE_URL=https://api.withpersona.com
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Agent surface
MCP_API_KEY=replace-with-at-least-24-random-characters
LIVE_FIRE_TOKEN=replace-with-a-separate-random-operator-token

# Worker
WORKER_CONCURRENCY=5
# Business days re-pulled by the nightly close collector / valuer (corrections self-heal).
VALUATION_LOOKBACK_DAYS=7
# Orders that hit a broker 5xx / timeout are stored as `approved` and re-sent at
# this interval until the broker answers (ADR-0007).
ORDER_RETRY_MS=30000

# Deployment split (see README "Deploy"):
#   Render (API + worker container): everything above except WEB_ORIGIN's counterpart.
#   Vercel (apps/web):               only API_BASE_URL, WEB_ORIGIN, NODE_ENV.
# Provider secrets and DATABASE_URL never go to the web deployment.
